# Headers para Cloudflare Workers Static Assets / Pages.
# El sitio no tenia ninguno: sin CSP, sin nosniff, sin HSTS.
#
# script-src 'self' es posible porque todo el JS vive en assets/site.js
# (no quedan onclick/onchange inline).
# style-src-attr 'unsafe-inline' es necesario por los style="" inline que
# quedan en el markup (~100); migrarlos a clases es deuda de Fase 2.
# Los assets se referencian con ?v=YYYYMMDD: al editarlos hay que bumpear
# la query en los 4 HTML o el navegador sirve la version cacheada 1 año.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
